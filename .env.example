# `.env` holds the committed production defaults.
# For local development copy this to `.env.local` (gitignored) and adjust —
# Vite gives `.env.local` precedence over `.env`.

VITE_ENVIRONMENT=development

# Base URL of the backend API (no trailing slash).
# Local backend:  http://localhost:4001
# Hosted backend: https://backend.webschema.online
VITE_API_URL=http://localhost:4001
